generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// ─── User & Auth ────────────────────────────────────────────
enum UserRole {
    ADMIN
    STUDENT
}

model User {
    id             String   @id @default(cuid())
    studentId      String?  @unique // e.g., "STU-A1B2C"
    email          String   @unique
    name           String?
    password       String
    role           UserRole @default(STUDENT)
    creditLimit    Int?     // null = unlimited; percentage of pool (e.g., 30 = 30%)
    isBlocked      Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    creditUsages   CreditUsage[]
    generatedPrompts GeneratedPrompt[]
    generatedImages  GeneratedImage[]
    generatedVideos  GeneratedVideo[]
    characters       Character[]

    @@index([role])
    @@map("users")
}

// ─── Credit Tracking ────────────────────────────────────────
enum ToolType {
    IMAGE_GENERATOR
    VIDEO_GENERATOR
    PROMPT_MULTIPLIER
}

model CreditUsage {
    id        String   @id @default(cuid())
    userId    String
    tool      ToolType
    cost      Int      @default(1) // credits consumed
    metadata  String?  // JSON string with generation details
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([tool])
    @@index([createdAt(sort: Desc)])
    @@map("credit_usages")
}

// ─── Prompt Multiplier (existing) ───────────────────────────
model GeneratedPrompt {
    id                     String   @id @default(cuid())
    originalInput          String
    enhancedOutput         String
    transformationAnalysis String?
    architectureChosen     String?
    userId                 String?
    createdAt              DateTime @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([createdAt(sort: Desc)])
    @@index([userId])
    @@map("generated_prompts")
}

// ─── Image Generator ────────────────────────────────────────
model GeneratedImage {
    id        String   @id @default(cuid())
    prompt    String
    imageUrl  String?
    referenceImages String[] @default([]) // cloud storage paths
    style     String?
    aspectRatio String? // e.g., "1:1", "16:9", "9:16"
    status    String   @default("pending") // pending, completed, failed
    userId    String?
    createdAt DateTime @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([createdAt(sort: Desc)])
    @@index([userId])
    @@map("generated_images")
}

// ─── Video Generator ────────────────────────────────────────
model GeneratedVideo {
    id             String   @id @default(cuid())
    prompt         String
    videoUrl       String?
    referenceImages String[] @default([]) // cloud storage paths
    referenceVideos String[] @default([]) // cloud storage paths
    referenceAudios String[] @default([]) // cloud storage paths
    resolution     String   @default("720p")
    aspectRatio    String   @default("16:9")
    duration       String   @default("5s")
    status         String   @default("pending") // pending, processing, completed, failed
    errorMessage   String?
    jobId          String?
    userId         String?
    createdAt      DateTime @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([createdAt(sort: Desc)])
    @@index([userId])
    @@index([status, jobId, createdAt])
    @@map("generated_videos")
}

// ─── Example Videos Catalogue (existing) ────────────────────
model ExampleVideo {
    id             String   @id @default(cuid())
    linkId         Int      @unique
    url            String
    platform       String
    status         String
    creator        String?
    caption        String?
    promptText     String?
    promptLocation String?
    videoType      String?
    referenceImage String?
    techniques     String[] @default([])
    keyInsights    String[] @default([])
    style          String?
    hasTimestamps  Boolean  @default(false)
    hasDialogue    Boolean  @default(false)
    hasCameraDir   Boolean  @default(false)
    hasSfx         Boolean  @default(false)
    likes          Int?
    comments       Int?
    createdAt      DateTime @default(now())

    @@index([platform])
    @@index([creator])
    @@map("example_videos")
}

// ─── Character Management ───────────────────────────────────
model Character {
    id          String   @id @default(cuid())
    name        String
    description String?
    images      String[] // Cloud storage paths for the images (min 5)
    userId      String
    status      String   @default("completed") // processing, completed, failed
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("characters")
}

// ─── Request Logging ─────────────────────────────────────────
model RequestLog {
    id         String   @id @default(cuid())
    method     String                    // GET, POST, PATCH, DELETE
    path       String                    // e.g. /api/videos/generate
    statusCode Int                       // HTTP response status
    durationMs Int                       // time from request start to response
    userId     String?                  // null for unauthenticated requests
    ipAddress  String?
    userAgent  String?
    error      String?                  // error message on 4xx/5xx, if any

    createdAt  DateTime @default(now())

    @@index([path])
    @@index([userId])
    @@index([statusCode])
    @@index([createdAt(sort: Desc)])
    @@map("request_logs")
}
